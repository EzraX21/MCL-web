{
  "name": "MCL — Minecraft Launcher",
  "short_name": "MCL",
  "description": "Open-source Minecraft: Java Edition launcher with a native GUI and a TUI mode.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f7f8fa",
  "theme_color": "#0d6ab3",
  "icons": [
    { "src": "assets/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "assets/logo.png", "sizes": "256x256", "type": "image/png", "purpose": "any" }
  ]
}
